rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function hasRequiredFields(required) {
      return request.resource.data.keys().hasAll(required);
    }

    // Users collection - each user owns their document
    match /users/{userId} {
      allow read; // Allow reading all users (for signup limit check - unauthenticated)
      allow write: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Exercises subcollection
      match /exercises/{exerciseId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) && 
          hasRequiredFields(['name', 'difficulty', 'muscleGroups']) &&
          request.resource.data.name is string &&
          request.resource.data.difficulty in ['beginner', 'intermediate', 'advanced'] &&
          request.resource.data.muscleGroups is list;
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Workouts subcollection
      match /workouts/{workoutId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) &&
          hasRequiredFields(['name', 'duration', 'exercises']) &&
          request.resource.data.name is string &&
          request.resource.data.duration in ['short', 'medium', 'long'] &&
          request.resource.data.exercises is list;
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Meals subcollection
      match /meals/{mealId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) &&
          hasRequiredFields(['name', 'date']);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Meal Logs subcollection
      match /mealLogs/{mealLogId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Progress photos subcollection
      match /progressPhotos/{photoId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Workout Logs subcollection
      match /workoutLogs/{document=**} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Catch-all: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

      
      // Exercises subcollection
      match /exercises/{exerciseId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) && 
          hasRequiredFields(['name', 'difficulty', 'muscleGroups']) &&
          request.resource.data.name is string &&
          request.resource.data.difficulty in ['beginner', 'intermediate', 'advanced'] &&
          request.resource.data.muscleGroups is list;
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Workouts subcollection - NEW STRUCTURE
      match /workouts/{workoutId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) &&
          hasRequiredFields(['name', 'duration', 'exercises']) &&
          request.resource.data.name is string &&
          request.resource.data.duration in ['short', 'medium', 'long'] &&
          request.resource.data.exercises is list;
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Meals subcollection
      match /meals/{mealId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId) &&
          hasRequiredFields(['name', 'date']);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Meal Logs subcollection
      match /mealLogs/{mealLogId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Progress photos subcollection
      match /progressPhotos/{photoId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // Workout Logs subcollection
      match /workoutLogs/{document=**} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // Catch-all: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
